{
  "manifest_version": 2,
  "name": "Codex Thunderbird Plugin",
  "version": "0.3.0",
  "description": "Pairs Thunderbird with the local Codex Thunderbird Plugin.",
  "browser_specific_settings": {
    "gecko": {
      "id": "codex-thunderbird-plugin@example.local",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "accountsIdentities",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "downloads",
    "storage",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "Codex Thunderbird Plugin",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
